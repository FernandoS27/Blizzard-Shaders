// The engine fills `int b_iUVMapping[8]` per instance via InitShader, so it is an
// ARRAY, not a #define — the driver passes each slot's mode as SC2_UVMAPPING<i>
// (sc2_shaders_cfg.perm_defines) and the emitter unroll instantiates the generic
// GenUV with that literal, which is exactly how fxc sees `b_iUVMapping[i]` once
// InitShader's literal stores are folded.
#ifndef SC2_UVMAPPING0
#define SC2_UVMAPPING0 0
#endif
#ifndef SC2_UVMAPPING1
#define SC2_UVMAPPING1 0
#endif
#ifndef SC2_UVMAPPING2
#define SC2_UVMAPPING2 0
#endif
#ifndef SC2_UVMAPPING3
#define SC2_UVMAPPING3 0
#endif
#ifndef SC2_UVMAPPING4
#define SC2_UVMAPPING4 0
#endif
#ifndef SC2_UVMAPPING5
#define SC2_UVMAPPING5 0
#endif
#ifndef SC2_UVMAPPING6
#define SC2_UVMAPPING6 0
#endif
#ifndef SC2_UVMAPPING7
#define SC2_UVMAPPING7 0
#endif

