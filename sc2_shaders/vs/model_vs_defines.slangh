//
// Preprocessor-only header shared by the Model vertex-shader translation units.
//
// Slang's `__include` merges DECLARATIONS into the module but each `.slang` file
// is its own PREPROCESSING unit, so `#define`s do not flow between them (the M1
// lesson recorded in docs/SC2_SHADERS_IMPLEMENTATION.md).  A plain `#include` of
// this header does flow, so the compile-time axis defaults and the .fx enums live
// here once instead of being copy-pasted into every VS file.
//
// Path is written from the module root (`-I sc2_shaders`), so every VS file
// includes it identically regardless of its own directory.
//
// Contains ONLY #defines — no declarations — so including it three times inside
// one module is safe.

#ifndef SC2_MODEL_VS_DEFINES_H
#define SC2_MODEL_VS_DEFINES_H

// ---------------------------------------------------------------------------
// Compile-time axis defaults.  The driver emits `-Db_x=<v>` only for NONZERO axes
// (sc2_shaders_cfg.bv_to_defines), matching the reference's `#define b_* 0` base
// map, so every axis read in an *expression* needs a 0 default here.
// ---------------------------------------------------------------------------
